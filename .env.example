# SHIELD by Kentro v2.0 - environment variables (example)
#
# Copy to .env and fill in real values for local development.
# .env is gitignored. NEVER commit real secrets.
# Spec references: Master Spec §4.4 (LLM), §4.5 (auth), §12 (redaction).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (Postgres 16 - locked, Master Spec §2)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://shield:shield@db:5432/shield

# ---------------------------------------------------------------------------
# Redis (Celery queue + ephemeral cache - Master Spec §11)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Object storage (MinIO in dev; S3 + KMS in prod - Master Spec §11)
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=shield-artifacts
S3_ACCESS_KEY=shield-minio
S3_SECRET_KEY=shield-minio-secret
S3_KMS_KEY_ID=dev-stub-key

# ---------------------------------------------------------------------------
# Keycloak / OIDC (Master Spec §4.5)
# ---------------------------------------------------------------------------
KEYCLOAK_ISSUER=http://keycloak:8080/realms/shield
KEYCLOAK_AUDIENCE=shield-api
KEYCLOAK_CLIENT_ID=shield-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# NextAuth (web)
# Generate NEXTAUTH_SECRET with: openssl rand -hex 32
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# LLM provider (Master Spec §4.4 - env-configurable, NEVER hardcoded)
# Allowed providers: anthropic, openai, azure_openai, bedrock, gemini, local
# SHIELD_LLM_MODE: fixture (offline test mode) | live (real API calls)
#
# To enable real AI (e.g. tech-debt extraction): set SHIELD_LLM_MODE=live and
# provide ANTHROPIC_API_KEY below, then `docker compose up -d api`. In fixture
# mode no real call is made (and outside the test suite no canned response is
# registered), so AI features are effectively disabled. Verify wiring at
# GET /admin/ai-status (admin) - `ready: true` means a live call will run.
# ---------------------------------------------------------------------------
SHIELD_LLM_PROVIDER=anthropic
SHIELD_LLM_MODEL=claude-sonnet-5
SHIELD_LLM_MODE=fixture
# Required when SHIELD_LLM_MODE=live and SHIELD_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Whole-call deadline (seconds) for a single AI run. On expiry the run-ai route
# returns 504 and applies nothing. 0 disables the deadline. (Task S2-A E-1.)
SHIELD_LLM_TIMEOUT_SECONDS=300
# ENVIRONMENT=production requires SHIELD_LLM_MODE=live (real analysis). Set
# SHIELD_DEMO=1 to explicitly permit a fixture-mode (simulated) demo in
# production; any other value keeps that guard armed. (Task S2-A G-3.)
SHIELD_DEMO=

# ---------------------------------------------------------------------------
# Rate limiting (Task S2-A H-2). Redis-backed when REDIS_URL is reachable, else
# an in-memory fallback. Auth endpoints are keyed per-IP; AI run endpoints per
# user. Per-minute token buckets; 0 disables that class.
# ---------------------------------------------------------------------------
SHIELD_RATE_LIMIT_AUTH_PER_MIN=10
SHIELD_RATE_LIMIT_AI_PER_MIN=6

# ---------------------------------------------------------------------------
# Bootstrap admin service account
# Self-registration only ever creates regular `client` users. The standing
# platform admin is seeded from these vars at API startup (idempotent: if the
# email already exists nothing happens). Leave empty to skip seeding. Only an
# existing admin can create more admins via the admin portal.
# ---------------------------------------------------------------------------
SHIELD_BOOTSTRAP_ADMIN_EMAIL=
SHIELD_BOOTSTRAP_ADMIN_PASSWORD=
SHIELD_BOOTSTRAP_ADMIN_NAME=SHIELD Admin

# Deactivated accounts with no login for this many days are permanently purged
# by the startup maintenance job (accounts that still own data are skipped).
SHIELD_USER_PURGE_IDLE_DAYS=365

# ---------------------------------------------------------------------------
# Feature flags (Master Spec §2). MFA (TOTP) + email verification landed in the
# D-017 auth package (July 2026).
# ---------------------------------------------------------------------------
# When true, users WITHOUT a TOTP factor still log in, but the login response
# carries mfa_setup_required so the frontend nudges enrollment. It does NOT block
# anything server-side today (hard enforcement is a future hardening step - see
# DECISIONS D-017). Users who HAVE enrolled always get the TOTP challenge
# regardless of this flag.
SHIELD_AUTH_REQUIRE_MFA=false
# When true, login is refused with 403 until the account's email is verified
# (checked only after the password verifies, so it can't be used as an
# account-existence oracle). A verification email is always minted on register
# regardless of this flag.
SHIELD_AUTH_REQUIRE_EMAIL_VERIFY=false
# Gates real SMTP delivery in app/notifications/email.py. When false (v1 default)
# the sender logs the intended message and returns without touching the network.
SHIELD_EMAIL_DELIVERY_ENABLED=false

# ---------------------------------------------------------------------------
# Redaction (Master Spec §12 - mandatory security boundary, not cosmetic)
# Values: strict | standard | off  (off forbidden outside dev)
# ---------------------------------------------------------------------------
SHIELD_REDACTION_MODE=strict

# ---------------------------------------------------------------------------
# Session security (Master Spec §4.5)
# ---------------------------------------------------------------------------
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1800
SHIELD_ACCOUNT_LOCKOUT_MAX_ATTEMPTS=10
SHIELD_ACCOUNT_LOCKOUT_WINDOW_SECONDS=900
# ENFORCED session limits (D-017 auth package): checked server-side on
# /auth/refresh against the refresh_tokens rotation records. Idle timeout
# bounds the gap between refreshes; forced re-auth caps a session family's
# total age. Set either to 0 to disable it.
SHIELD_IDLE_TIMEOUT_SECONDS=1800
SHIELD_FORCED_REAUTH_SECONDS=86400
# TTL of the intermediate MFA-challenge token issued by /auth/login when a user
# has a TOTP factor - the window to enter the 6-digit code (default 5 min).
JWT_MFA_CHALLENGE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Mail (MailHog in dev; SES/Graph in prod)
# ---------------------------------------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@shield.local
# Base URL the frontend is served from, used to build absolute links in outbound
# email (e.g. the email-verification link). Empty -> a root-relative path.
SHIELD_FRONTEND_BASE_URL=
