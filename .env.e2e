# Local e2e stack environment (container-hosted infra on localhost).
# Used by scripts that start the API and web app for Playwright runs.
# Not a secrets file: dev-only values for the disposable local stack.
DATABASE_URL=postgresql+psycopg://shield:shield@localhost:5432/shield
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=shield-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_KMS_KEY_ID=dev-stub-key
ENVIRONMENT=development
SHIELD_LLM_MODE=fixture
JWT_SIGNING_SECRET=e2e-local-jwt-secret-not-production-0000000000
SHIELD_BOOTSTRAP_ADMIN_EMAIL=admin@shield.local
SHIELD_BOOTSTRAP_ADMIN_PASSWORD=e2e-admin-password-1234
